	<parameter name="IMAGE_PATH" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT transportes.`CONDUCTOR`.dni,
	transportes.`CONDUCTOR`.nombre,
	transportes.`CONDUCTOR`.apellido,
	transportes.`TIPO_DE_VEHICULO`.foto,
	transportes.`CONDUCTOR`.telefono,
	transportes.`VEHICULOS`.cod_vehiculo,
	transportes.`TIPO_DE_VEHICULO`.instrucciones,
	transportes.`TIPO_DE_VEHICULO`.estipulacion,
	transportes.`SISTEMA_DE_CARGA_DE_VEHICULO`.descripcion
FROM transportes.`CONDUCTOR_has_VEHICULOS`
	INNER JOIN transportes.`VEHICULOS` ON 
	 transportes.`CONDUCTOR_has_VEHICULOS`.vehiculos_cod_vehiculo = transportes.`VEHICULOS`.cod_vehiculo 
	INNER JOIN transportes.`CONDUCTOR` ON 
	 transportes.`CONDUCTOR_has_VEHICULOS`.conductor_dni = transportes.`CONDUCTOR`.dni 
	INNER JOIN transportes.`TIPO_DE_VEHICULO` ON 
	 transportes.`VEHICULOS`.cod_tipo_vehiculo = transportes.`TIPO_DE_VEHICULO`.cod_tipo_vehiculo 
	INNER JOIN transportes.`SISTEMA_DE_CARGA_DE_VEHICULO` ON 
	 transportes.`TIPO_DE_VEHICULO`.`SISTEMAEDCARGAVEHICULO_cod_sistem_carga` = transportes.`SISTEMA_DE_CARGA_DE_VEHICULO`.cod_sistema_carga]]></query>
