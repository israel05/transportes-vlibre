	<query language="SQL"><![CDATA[SELECT transportes.`VEHICULOS`.cod_vehiculo,
	transportes.`VEHICULOS`.`MMA`,
	transportes.`VEHICULOS`.`dimension_A`,
	transportes.`VEHICULOS`.`dimension_L`,
	transportes.`VEHICULOS`.`dimension_H`,
	transportes.`VEHICULOS`.carga_util,
	transportes.`VEHICULOS`.cod_tipo_vehiculo,
	transportes.`TIPO_DE_VEHICULO`.cod_tipo_vehiculo,
	transportes.`TIPO_DE_VEHICULO`.`SISTEMAEDCARGAVEHICULO_cod_sistem_carga`,
	transportes.`TIPO_DE_VEHICULO`.estipulacion,
	transportes.`TIPO_DE_VEHICULO`.instrucciones,
	transportes.`TIPO_DE_VEHICULO`.foto,
	transportes.`TIPO_DE_VEHICULO`.tiene_rampa,
	transportes.`TIPO_DE_VEHICULO`.puede_adr,
	transportes.`TIPO_DE_VEHICULO`.puede_atp,
	transportes.`SISTEMA_DE_CARGA_DE_VEHICULO`.descripcion,
	transportes.`SISTEMA_DE_CARGA_DE_VEHICULO`.cod_sistema_carga
FROM transportes.`VEHICULOS`
	INNER JOIN transportes.`TIPO_DE_VEHICULO` ON 
	 transportes.`VEHICULOS`.cod_tipo_vehiculo = transportes.`TIPO_DE_VEHICULO`.cod_tipo_vehiculo 
	INNER JOIN transportes.`SISTEMA_DE_CARGA_DE_VEHICULO` ON 
	 transportes.`TIPO_DE_VEHICULO`.`SISTEMAEDCARGAVEHICULO_cod_sistem_carga` = transportes.`SISTEMA_DE_CARGA_DE_VEHICULO`.cod_sistema_carga]]></query>
