<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/23.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.israeldelamo.transportes.controladores.LoginController">
      <bottom>
      
          <!-- Formulario para ingresar usuario y contraseña -->
          <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="100.0" minWidth="800.0" styleClass="container" BorderPane.alignment="BOTTOM_CENTER">
         <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="100.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
            <children>
      
                                     <!-- Botón de GESTOR -->
                      <Button maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#logueoGestor" prefHeight="102.0" prefWidth="200.0" text="%Gestor">
                          <styleClass>
                              <String fx:value="btn" />
                          </styleClass>
                          <tooltip>
                              <Tooltip text="Entrar como gestor" />
                          </tooltip>
                      </Button>
               <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="103.0" HBox.hgrow="ALWAYS">
                  <children>
                          <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="USUARIO" VBox.vgrow="ALWAYS" />
                          <TextField fx:id="fld_user" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" promptText="tu usuario" styleClass="label" stylesheets="@../css/estilos.css" />
                          <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="PASSWORD" VBox.vgrow="ALWAYS" />
                          <PasswordField fx:id="fld_passw" promptText="tu contraseña" styleClass="label" stylesheets="@../css/estilos.css" />
                  </children>
               </VBox>
               <Button alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#logueoConductor" prefHeight="116.0" prefWidth="200.0" styleClass="btn" text="%Conductor" textAlignment="CENTER">
                  <tooltip>
                     <Tooltip text="Entrar como conductor" />
                  </tooltip>
               </Button>
            </children>
         </HBox>
         <BorderPane.margin>
            <Insets left="10.0" top="10.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </padding>
          </VBox>
      </bottom>
      <top>
         <VBox minHeight="50.0" BorderPane.alignment="TOP_CENTER">
            <children>
            
                <!-- Contenedor para los botones adicionales (Ayuda, Salir) -->
                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" minHeight="50.0" minWidth="-Infinity" VBox.vgrow="ALWAYS">
                    <!-- Botón de AYUDA -->
                    <Button contentDisplay="CENTER" minWidth="200.0" mnemonicParsing="false" onAction="#mostrarAyuda" styleClass="btn" text="%PreguntasFrecuentes">
                        <tooltip>
                            <Tooltip text="Ayuda en linea sobre este programa" />
                        </tooltip>
                    </Button>
            
                    <!-- Mensaje central -->
                    <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="h1" stylesheets="@../css/estilos.css" text="BOLSA DE CARGAS" textAlignment="CENTER" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                            <Insets left="20.0" right="20.0" />
                        </HBox.margin>
                    </Label>
            
                       <!-- Botón de SALIR -->
                    <Button fx:id="btn_salir" minWidth="200.0" mnemonicParsing="false" onAction="#salirDeLaApp" styleClass="btn" text="%Salir">
                        <tooltip>
                            <Tooltip text="Salir del programa" />
                        </tooltip>
                    </Button>
                </HBox>
            </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         </VBox>
      </top>
   <center>
      <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <children>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" pannable="true" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
               <content>
<TilePane fx:id="tp_pedidos" alignment="CENTER" hgap="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefColumns="0" prefRows="0" vgap="10.0">
                      <children>
                      </children>
                   </TilePane>
               </content>
            </ScrollPane>
         </children>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
      </VBox>
   </center>
   <left>
           <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="300.0" BorderPane.alignment="CENTER_LEFT">
               <children>
            <VBox alignment="CENTER" layoutX="10.0" layoutY="210.0" maxHeight="-Infinity" maxWidth="-Infinity" VBox.vgrow="ALWAYS">
               <children>
                     <ImageView fitHeight="250.0" fitWidth="250.0" onDragDetected="#logeoAdministrador" preserveRatio="true">
                        <effect>
                           <InnerShadow choke="0.21" offsetX="1.0" radius="18.7325" width="55.93" />
                        </effect>
                        <image>
                           <Image url="@../imagenes/logoICJ.png" />
                        </image>
                     <VBox.margin>
                        <Insets bottom="100.0" />
                     </VBox.margin>
                     </ImageView>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTutorialGst" styleClass="btn" text="Tutorial Gestor">
                     <graphic>
                               <SVGPath content="M 8 12 H 56 C 58 12 58 14 58 16 V 48 C 58 50 56 52 54 52 H 10 C 8 52 6 50 6 48 V 16 C 6 14 8 12 10 12 Z &#10;M 28 22 L 28 42 L 46 32 Z&#10;M 16 50 L 48 50 &#10;M 12 50 L 12 58 L 52 58 L 52 50 &#10;" fill="#c11c1c" />
                     </graphic>
                  </Button>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTutorialCnd" styleClass="btn" text="Tutorial Conductor">
                     <graphic>
                               <SVGPath content="M 8 12 H 56 C 58 12 58 14 58 16 V 48 C 58 50 56 52 54 52 H 10 C 8 52 6 50 6 48 V 16 C 6 14 8 12 10 12 Z &#10;M 28 22 L 28 42 L 46 32 Z&#10;M 16 50 L 48 50 &#10;M 12 50 L 12 58 L 52 58 L 52 50 &#10;" fill="#c11c1c" />
                     </graphic>
                  </Button>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTutorialGst" styleClass="btn" text="Tutorial Administración">
                     <graphic>
                               <SVGPath fx:id="abrirTutorialAdm" content="M 8 12 H 56 C 58 12 58 14 58 16 V 48 C 58 50 56 52 54 52 H 10 C 8 52 6 50 6 48 V 16 C 6 14 8 12 10 12 Z &#10;M 28 22 L 28 42 L 46 32 Z&#10;M 16 50 L 48 50 &#10;M 12 50 L 12 58 L 52 58 L 52 50 &#10;" fill="#c11c1c" onMouseClicked="#abrirTutorialAdm" />
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
               </children>
         <opaqueInsets>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </opaqueInsets>
           </VBox>
   </left>
   </BorderPane>
