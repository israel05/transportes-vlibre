	<parameter name="FECHAINICIO" class="java.lang.String"/>
	<parameter name="FECHAFINAL" class="java.lang.String"/>
	<query language="sql"><![CDATA[select  transportes.`CARGA_Y_ENTREGA`.cod_carga ,
 transportes.`CARGA_Y_ENTREGA`.fecha_creaccion, 
 transportes.`CARGA_Y_ENTREGA`.ya_reservado 
 FROM  transportes.`CARGA_Y_ENTREGA` 
 WHERE  transportes.`CARGA_Y_ENTREGA`.fecha_creaccion
 BETWEEN  $P{FECHAINICIO}  AND  $P{FECHAFINAL} 
 AND  transportes.`CARGA_Y_ENTREGA`.ya_reservado ="0" ]]></query>
